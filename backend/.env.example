# ─────────────────────────────────────────────────────────────────────────────
# GridFlex Backend — Environment Configuration
# Copy to .env and adjust.  Never commit .env.
#
# LOCAL DEVELOPMENT (default — no AWS credentials required)
# ──────────────────────────────────────────────────────────
# APP_MODE=local
# uvicorn app.main:app --reload
#
# AWS / PRODUCTION MODE
# ──────────────────────
# APP_MODE=aws  (plus AWS_REGION + credentials below)
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime mode ──────────────────────────────────────────────────────────────
# "local" = in-memory store, no AWS credentials required (DEFAULT for dev)
# "aws"   = DynamoDB as primary store (production / staging)
APP_MODE=local

# ── AWS / DynamoDB ────────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
# Leave blank for real AWS; set to http://localhost:8000 for LocalStack
AWS_ENDPOINT_URL=
DYNAMODB_TABLE_PREFIX=gridflex

# ── Grid parameters ───────────────────────────────────────────────────────────
FEEDER_ID=F01
GRID_IMPORT_LIMIT=80
BATTERY_CAPACITY_KWH=200
BATTERY_RESERVE_PCT=20
BATTERY_MAX_DISCHARGE_KW=75
BATTERY_MAX_CHARGE_KW=50
CRITICAL_LOAD_KW=48
PEAK_SOLAR_KW=150

# ── SNS Alerts (AWS mode only) ────────────────────────────────────────────────
SNS_ENABLED=false
SNS_TOPIC_ARN=

# ── CORS ───────────────────────────────────────────────────────────────────────
# Extra allowed origins (comma-separated) beyond localhost + CloudFront.
# Set to your Vercel frontend URL in production:
# CORS_ORIGINS=https://your-app.vercel.app
CORS_ORIGINS=

# ── Groq — GridFlex Reliability Copilot ───────────────────────────────────────
# Set GROQ_ENABLED=true to activate real LLM inference (DEFAULT when a key is set).
# Requires a Groq API key (https://console.groq.com/keys).
# When false or no key, the Copilot returns deterministic GridFlex data — no API call.
#
# Model selection guide:
#   openai/gpt-oss-120b   — tool use + JSON mode, ~500 tok/s, DEFAULT
#   qwen/qwen3.8-27b      — parallel tool use (preview)
#   openai/gpt-oss-20b    — smaller/faster variant
#
GROQ_ENABLED=true
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MAX_TOKENS=1024
GROQ_TEMPERATURE=0.5
