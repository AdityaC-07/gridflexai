# ─────────────────────────────────────────────────────────────────────────────
# GridFlex Backend — Environment Configuration
# Copy to .env and adjust.  Never commit .env.
#
# LOCAL DEVELOPMENT (default — no AWS credentials required)
# ──────────────────────────────────────────────────────────
# APP_MODE=local
# uvicorn app.main:app --reload
#
# AWS / PRODUCTION MODE
# ──────────────────────
# APP_MODE=aws  (plus AWS_REGION + credentials below)
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime mode ──────────────────────────────────────────────────────────────
# "local" = in-memory store, no AWS credentials required (DEFAULT for dev)
# "aws"   = DynamoDB as primary store (production / staging)
APP_MODE=local

# ── AWS / DynamoDB ────────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
# Leave blank for real AWS; set to http://localhost:8000 for LocalStack
AWS_ENDPOINT_URL=
DYNAMODB_TABLE_PREFIX=gridflex

# ── Grid parameters ───────────────────────────────────────────────────────────
FEEDER_ID=F01
GRID_IMPORT_LIMIT=80
BATTERY_CAPACITY_KWH=200
BATTERY_RESERVE_PCT=20
BATTERY_MAX_DISCHARGE_KW=75
BATTERY_MAX_CHARGE_KW=50
CRITICAL_LOAD_KW=48
PEAK_SOLAR_KW=150

# ── SNS Alerts (AWS mode only) ────────────────────────────────────────────────
SNS_ENABLED=false
SNS_TOPIC_ARN=

# ── Amazon Bedrock — GridFlex Reliability Copilot ─────────────────────────────
# Set BEDROCK_ENABLED=true to activate real LLM inference.
# Requires AWS credentials (env vars / IAM role / ~/.aws/credentials).
# When false, the Copilot returns deterministic GridFlex data — no Bedrock call.
#
# Model selection guide (ap-south-1 region):
#   amazon.nova-lite-v1:0        — fast, low cost, tool-use, DEFAULT
#   amazon.nova-pro-v1:0         — higher capability, higher cost
#   anthropic.claude-3-haiku-20240307-v1:0  — Claude Haiku (if enabled in account)
#
# Credentials — use ONE of:
#   export AWS_ACCESS_KEY_ID=...  AWS_SECRET_ACCESS_KEY=...  AWS_SESSION_TOKEN=...
#   aws configure (creates ~/.aws/credentials)
#   ECS task role / EC2 instance profile (production — no env vars needed)
#
BEDROCK_ENABLED=false
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_MAX_TOKENS=1000
BEDROCK_TEMPERATURE=0.2

# Optional: Bedrock Guardrails (leave blank to disable)
# Create a guardrail in the Bedrock console, then set:
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=
